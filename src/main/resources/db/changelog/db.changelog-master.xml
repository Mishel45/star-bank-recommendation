<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="mihail">
        <createTable tableName="recommendation_rules">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="product_text" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="query_conditions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_rule_condition" referencedTableName="recommendation_rules" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="query" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="negate" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="query_arguments">
            <column name="condition_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_condition_argument" referencedTableName="query_conditions" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="argument" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>